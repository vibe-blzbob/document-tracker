{
  "name": "document-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "tsc -b && vite build",
    "build": "npm run build:client",
    "build:win": "npm run build && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:winexe /out:DocTrack-LGU.exe windows-launcher\\Program.cs",
    "package": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-release.ps1",
    "installer": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-release.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-release.ps1",
    "start:app": "start DocTrack-LGU.exe",
    "shortcut": "powershell -ExecutionPolicy Bypass -File .\\create-desktop-shortcut.ps1",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
